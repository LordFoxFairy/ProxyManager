{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProxyManager",
  "version": "0.1.0",
  "identifier": "com.proxymanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ProxyManager",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "${TAURI_UPDATER_PUBKEY}",
      "endpoints": [
        "https://github.com/LordFoxFairy/ProxyManager/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../server/bundle/": "server/",
      "../../runtime/node/": "runtime/node/",
      "../../runtime/mihomo/": "runtime/mihomo/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
